<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ff303030"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="61dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:id="@+id/but_exit"
            android:background="@mipmap/back_b"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <CheckBox
            android:textColor="#9ff000"
            android:id="@+id/checkBox"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:button="@drawable/bg_checkbox"
            android:text="@string/selectAll"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/but_exit"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="#ff00"
            android:id="@+id/count_text"
            android:background="#00000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/count_file"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:textColor="#9ff000"
            android:id="@+id/but_delete"
            android:background="#00000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/delete_select_files"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/count_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:textColor="#9ff000"
            android:id="@+id/but_edit"
            android:background="#00000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/threedot"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/count_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:textColor="#9ff000"
            android:id="@+id/but_Cancel"
            android:background="#00000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/Cancel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/but_delete"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <GridView
        android:id="@+id/gridView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
    <RelativeLayout
        android:id="@+id/DeleteAert"
        android:background="#80000000"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/round_back_select_jh"
            android:visibility="visible"
            android:layout_width="320dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true">
            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/Sure_you_want_to_delete"
                android:layout_centerHorizontal="true"/>
            <Button
                android:id="@+id/alart_cancel"
                android:background="@drawable/round_back_jh"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="@string/Cancel"
                android:layout_alignTop="@+id/alart_ok"
                android:layout_marginStart="32dp"
                android:layout_alignParentStart="true"/>
            <Button
                android:id="@+id/alart_ok"
                android:background="@drawable/round_back_jh"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_marginBottom="19dp"
                android:text="@string/OK"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="32dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <com.joyhonest.wifi_check_adj.WaitView
        android:id="@+id/WaitView"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
