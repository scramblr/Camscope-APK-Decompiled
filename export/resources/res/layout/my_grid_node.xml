<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="100dp"
    android:minHeight="120dp">
    <com.joyhonest.wifi_check_adj.RoundRectLayout
        android:layout_gravity="center"
        android:id="@+id/item_view"
        android:layout_width="100dp"
        android:layout_height="100dp">
        <ImageView
            android:id="@+id/Grid_imageView1"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@mipmap/loading"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/video_bg"
            android:background="@mipmap/video_bg"
            android:visibility="invisible"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_delete"
            android:background="@mipmap/noselected_icon"
            android:visibility="visible"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="40dp"
            android:textColor="#ffff0000"
            android:id="@+id/tv_item"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/Grid_textView1"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Text"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/filename_TextView"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Text"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </com.joyhonest.wifi_check_adj.RoundRectLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/Grid_progressBar1"
        android:layout_width="80dp"
        android:layout_height="8dp"
        android:max="100"
        android:progressDrawable="@drawable/progressbar"
        style="?android:attr/progressBarStyleHorizontal"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <Button
        android:id="@+id/btn_down"
        android:background="@mipmap/download_icon"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="55dp"/>
</LinearLayout>
