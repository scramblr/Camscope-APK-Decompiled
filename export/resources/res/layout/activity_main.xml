<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ff101010"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/DispplayImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
    <RelativeLayout
        android:id="@+id/ShutterView"
        android:background="#60ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/battery_view"
        android:background="@mipmap/battery_3"
        android:layout_width="30dp"
        android:layout_height="15dp"
        android:layout_marginTop="10dp"
        app:layout_constraintRight_toLeftOf="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/toolbar"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:id="@+id/but_photo"
            android:background="@mipmap/photo_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toTopOf="@+id/but_video"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:id="@+id/but_video"
            android:background="@mipmap/video_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toTopOf="@+id/but_brow"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/but_photo"/>
        <Button
            android:id="@+id/but_brow"
            android:background="@mipmap/brow_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toTopOf="@+id/but_rota"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/but_video"/>
        <Button
            android:id="@+id/but_rota"
            android:background="@mipmap/rota_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toTopOf="@+id/but_mirr"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/but_brow"/>
        <Button
            android:id="@+id/but_mirr"
            android:background="@mipmap/mirr_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toTopOf="@+id/but_setup"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/but_rota"/>
        <Button
            android:id="@+id/but_setup"
            android:background="@mipmap/setup_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/but_mirr"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/toolbar1"
        android:background="#00ffffff"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"/>
        <Button
            android:background="@mipmap/photo_icon"
            android:visibility="invisible"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:background="@mipmap/video_icon"
            android:visibility="invisible"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:background="@mipmap/brow_icon"
            android:visibility="invisible"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:background="@mipmap/rota_icon"
            android:visibility="invisible"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <Space
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:background="@mipmap/mirr_icon"
            android:visibility="invisible"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/but_ear"
            android:background="@mipmap/left_ear"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"/>
    </LinearLayout>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#ff0000"
        android:id="@+id/RecTimeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="00:00:00"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ResolutionSelectView"
        android:background="@drawable/round_back_select_jh"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="18dp"
            android:textColor="#007b8b"
            android:gravity="center_vertical"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="@string/Resolution"/>
        <View
            android:id="@+id/line1"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="15dp"
            android:id="@+id/btn_Resolution1"
            android:background="#00ffffff"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="640x480"/>
        <View
            android:id="@+id/line2"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="15dp"
            android:id="@+id/btn_Resolution2"
            android:background="#00ffffff"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="1280x720"/>
        <View
            android:id="@+id/line3"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="15dp"
            android:id="@+id/btn_Resolution3"
            android:background="#00ffffff"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="1600x1200"/>
        <View
            android:id="@+id/line4"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="15dp"
            android:id="@+id/btn_Resolution4"
            android:background="#00ffffff"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="1920x1080"/>
        <View
            android:id="@+id/line5"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="15dp"
            android:id="@+id/btn_Resolution5"
            android:background="#00ffffff"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="2560x1440"/>
        <View
            android:id="@+id/line6"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="15dp"
            android:id="@+id/btn_Resolution6"
            android:background="#00ffffff"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="2592x1944"/>
        <View
            android:id="@+id/line7"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="15dp"
            android:id="@+id/btn_Resolution7"
            android:background="#00ffffff"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="3840x2160"/>
    </LinearLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_scale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="X1.0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/SensorWarnView"
        android:background="@drawable/round_back_select_jh_01"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="5:2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.55">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SensorWarm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ConnectedView"
        android:background="@drawable/round_back_jh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintHeight_percent="0.3"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_wifiCamera"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/main_Settings"
        android:background="@drawable/round_back_select_jh"
        android:visibility="gone"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="18dp"
            android:textColor="#007b8b"
            android:gravity="center"
            android:id="@+id/textView_s"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/Settings"/>
        <View
            android:id="@+id/line1_s"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="18dp"
            android:gravity="center"
            android:id="@+id/para_set"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/pic_para_settings"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line2_s"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="18dp"
            android:gravity="center"
            android:id="@+id/Resolution_set"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/Resolution"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ViewSetting"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent">
        <com.joyhonest.wifi_check_adj.MyButton
            android:id="@+id/Brightness_btn"
            android:visibility="visible"
            android:layout_width="200dp"
            android:layout_height="50dp"
            app:color_1="#f0292a44"
            app:img="@mipmap/brightness"
            app:img_sel="@mipmap/brightness_sel"
            app:layout_constraintBottom_toTopOf="@+id/Contrast_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:sValue="50"
            app:selected="true"
            app:title="@string/Brightness"/>
        <com.joyhonest.wifi_check_adj.MyButton
            android:id="@+id/Contrast_btn"
            android:layout_width="200dp"
            android:layout_height="50dp"
            app:color_1="#f0292a44"
            app:img="@mipmap/contrast"
            app:img_sel="@mipmap/contrast_sel"
            app:layout_constraintBottom_toTopOf="@+id/Saturation_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Brightness_btn"
            app:sValue="50"
            app:selected="true"
            app:title="@string/Contrast"/>
        <com.joyhonest.wifi_check_adj.MyButton
            android:id="@+id/Saturation_btn"
            android:layout_width="200dp"
            android:layout_height="50dp"
            app:color_1="#f0292a44"
            app:img="@mipmap/saturation"
            app:img_sel="@mipmap/saturation_sel"
            app:layout_constraintBottom_toTopOf="@+id/R_Color_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Contrast_btn"
            app:sValue="50"
            app:selected="true"
            app:stroke_color="#ffff0000"
            app:title="@string/Saturation"/>
        <com.joyhonest.wifi_check_adj.MyButton
            android:id="@+id/R_Color_btn"
            android:visibility="visible"
            android:layout_width="200dp"
            android:layout_height="50dp"
            app:color_1="#f0292a44"
            app:img="@mipmap/r"
            app:img_sel="@mipmap/r_sel"
            app:layout_constraintBottom_toTopOf="@+id/G_Color_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Saturation_btn"
            app:sValue="50"
            app:selected="true"
            app:title="@string/Red"/>
        <com.joyhonest.wifi_check_adj.MyButton
            android:id="@+id/G_Color_btn"
            android:layout_width="200dp"
            android:layout_height="50dp"
            app:color_1="#f0292a44"
            app:img="@mipmap/g"
            app:img_sel="@mipmap/g_sel"
            app:layout_constraintBottom_toTopOf="@+id/B_Color_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/R_Color_btn"
            app:sValue="50"
            app:selected="true"
            app:title="@string/Green"/>
        <com.joyhonest.wifi_check_adj.MyButton
            android:id="@+id/B_Color_btn"
            android:layout_width="200dp"
            android:layout_height="50dp"
            app:color_1="#f0292a44"
            app:img="@mipmap/b"
            app:img_sel="@mipmap/b_sel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/G_Color_btn"
            app:sValue="50"
            app:selected="true"
            app:title="@string/Blue"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/set6_R"
            android:background="#00000000"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="@+id/B_Color_btn"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/B_Color_btn">
            <Button
                android:id="@+id/btn_Reset"
                android:background="@mipmap/reset"
                android:layout_width="87dp"
                android:layout_height="45dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#ff37d3fb"
                android:gravity="center"
                android:id="@+id/txt_reset"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="28dp"
                android:text="@string/Reset"
                android:elevation="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/btn_Reset"
                app:layout_constraintLeft_toLeftOf="@+id/btn_Reset"
                app:layout_constraintRight_toRightOf="@+id/btn_Reset"
                app:layout_constraintTop_toTopOf="@+id/btn_Reset"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.joyhonest.wifi_check_adj.MySilder
            android:id="@+id/mySlider"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/set6_R"
            app:layout_constraintLeft_toRightOf="@+id/B_Color_btn"
            app:layout_constraintRight_toLeftOf="@+id/set6_R"
            app:layout_constraintTop_toTopOf="@+id/set6_R"
            app:leftColor="#ff02dffc"
            app:rightColor="#ff33344b"
            app:trackimg="@mipmap/brightness_sel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
